# Copy to D:\dsh\runtime\gateway.env on the server. Do not commit the copy.
# Model traffic leaves from this Windows box only. Desks never hold a vendor key: they send every
# model to the gateway on 8450 with their own per-person token, and the gateway picks the vendor
# by model name. Settings > 模型 (admin) writes these same lines; editing the file by hand also works.
# Fill only the vendors you use. Lines left empty are simply not offered to desks.

# OpenAI (gpt-*, o1/o3/o4*, chatgpt-*)
OPENAI_API_KEY=
# Anthropic (claude-*), reached through Anthropic's OpenAI-compatible endpoint
ANTHROPIC_API_KEY=
# DeepSeek (deepseek-*)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# xAI API key (grok-*). A Grok subscription is not a key: it is the OAuth file
# D:\dsh\runtime\oauth\xai-account.json, which the gateway renews; it wins over this key.
XAI_API_KEY=
# Kimi (kimi-*, moonshot-*) and Zhipu GLM (glm-*)
KIMI_API_KEY=
GLM_API_KEY=
# Any other OpenAI-compatible endpoint: add it in Settings > 模型 (custom). It is stored as
# KEY_<ID>=... here, with its base URL and model list in channels.json.

# Site default for new sessions on every desk (optional). Must be a model the server can reach;
# otherwise desks default to the first available model (subscription first).
DEFAULT_MODEL=
DEFAULT_EFFORT=high
