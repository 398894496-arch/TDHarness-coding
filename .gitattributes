# Keep every text file LF in the repository and in working trees, so a Windows
# editor cannot turn a two-line edit into a whole-file diff. Everything tracked
# here is already LF; this pins that rather than changing it.
* text=auto eol=lf
# Never touch binaries.
*.jpg binary
*.png binary
**/CompanyDesk-win.zip filter=lfs diff=lfs merge=lfs -text
**/CompanyDesk-mac.zip filter=lfs diff=lfs merge=lfs -text
*.dmg filter=lfs diff=lfs merge=lfs -text
server/caddy.exe filter=lfs diff=lfs merge=lfs -text
